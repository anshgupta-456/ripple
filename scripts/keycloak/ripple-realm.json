{
  "realm": "ripple",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {"name": "viewer"},
      {"name": "analyst"},
      {"name": "admin"},
      {"name": "merchant"}
    ]
  },
  "clients": [
    {
      "clientId": "ripple-spa",
      "name": "RIPPLE web app (public client, authorization code + PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8000/"],
      "webOrigins": ["http://localhost:8000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/",
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "ripple-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ripple-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "demo",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "priya",
      "enabled": true,
      "emailVerified": true,
      "email": "priya@example.test",
      "firstName": "Priya",
      "lastName": "Analyst",
      "credentials": [{"type": "password", "value": "priya-local-test", "temporary": false}],
      "realmRoles": ["analyst"]
    },
    {
      "username": "sam",
      "enabled": true,
      "emailVerified": true,
      "email": "sam@example.test",
      "firstName": "Sam",
      "lastName": "Admin",
      "credentials": [{"type": "password", "value": "sam-local-test", "temporary": false}],
      "realmRoles": ["admin"]
    },
    {
      "username": "norole",
      "enabled": true,
      "emailVerified": true,
      "email": "norole@example.test",
      "firstName": "No",
      "lastName": "Role",
      "credentials": [{"type": "password", "value": "norole-local-test", "temporary": false}]
    }
  ]
}
